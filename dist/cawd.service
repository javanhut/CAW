[Unit]
Description=caw wireless daemon
Wants=network.target
Before=network.target
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/bin/cawd

# cawd has no SIGTERM handler: there is no safe path from a signal to a
# pollable descriptor without libc, and every crate is #![forbid(unsafe_code)].
# `caw shutdown` asks over the socket instead, so the station deauthenticates
# and the access point frees the slot rather than holding it until a timeout.
# systemd still sends SIGTERM afterwards, which the daemon has usually beaten.
ExecStop=/usr/bin/caw shutdown

Restart=on-failure
RestartSec=2

# /run/caw holds the CLI socket; /var/lib/caw holds network profiles, which
# contain passphrases and so stay root-only.
RuntimeDirectory=caw
RuntimeDirectoryMode=0755
StateDirectory=caw
StateDirectoryMode=0700
UMask=0077

# CAP_NET_ADMIN for netlink and key installation, CAP_NET_RAW for the EAPOL
# packet socket, CAP_NET_BIND_SERVICE for the DHCP client's port 68. Nothing
# else is needed. The bounding set applies to root as well, so a capability
# missing here is missing for good: without CAP_NET_BIND_SERVICE the DHCP
# bind fails and every connection ends at "configuring addresses".
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
# A lease's DNS servers go into /etc/resolv.conf, written as a temporary file
# in /etc and renamed over the top. `strict` makes /etc read-only, and a
# ReadWritePaths= on the file alone would not do: rename() onto a bind mount
# fails with EBUSY, and the temporary file does not exist to be mounted.
ReadWritePaths=/etc
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6

# Soft-blocked radios are a common cause of "wifi does not work"; leave the
# rfkill node reachable so caw can report and clear it.
DeviceAllow=/dev/rfkill rw

[Install]
WantedBy=multi-user.target
