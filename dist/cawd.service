[Unit]
Description=caw wireless daemon
Wants=network.target
Before=network.target
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/bin/cawd

# The default KillSignal=, SIGTERM, is enough: cawd handles it the same way
# as `caw shutdown`, deauthenticating before it exits so the access point
# frees the station rather than holding it until a timeout.

Restart=on-failure
RestartSec=2

# /run/caw holds the CLI socket and the resolv.conf a lease writes;
# /var/lib/caw holds network profiles, which contain passphrases and so stay
# root-only. The umask makes every file the daemon creates root-only by
# default; the two that must not be — the socket and resolv.conf — are
# chmod'ed explicitly after creation.
RuntimeDirectory=caw
RuntimeDirectoryMode=0755
StateDirectory=caw
StateDirectoryMode=0700
UMask=0077

# CAP_NET_ADMIN for netlink and key installation, CAP_NET_RAW for the EAPOL
# packet socket, CAP_NET_BIND_SERVICE for the DHCP client's port 68. Nothing
# else is needed. The bounding set applies to root as well, so a capability
# missing here is missing for good: without CAP_NET_BIND_SERVICE the DHCP
# bind fails and every connection ends at "configuring addresses".
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Nothing outside the runtime and state directories is written. A lease's DNS
# servers go to /run/caw/resolv.conf, which /etc/resolv.conf is expected to
# be a symlink to (see the README); replacing /etc/resolv.conf in place would
# need all of /etc writable, since rename() onto a bind-mounted file fails.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6

# The daemon speaks to the kernel through sockets and touches no device node.
# Reporting and clearing a soft-blocked radio through /dev/rfkill is not
# implemented; when it is, it needs a `DeviceAllow=/dev/rfkill rw` here.
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
